# Copy to .env and fill in values:
#   cp .env.example .env

# Required for enrich=true ingest and vision inspect endpoints
COHERE_API_KEY=your-cohere-api-key-here

# Optional alias (Cohere dashboard often uses this name)
# CO_API_KEY=your-cohere-api-key-here

# Vision / image inspect + enrich (must support image_url)
COHERE_ENRICH_MODEL=command-a-vision-07-2025
COHERE_VISION_MODEL=command-a-vision-07-2025
# Agent / text tool-calling (no images required)
COHERE_TEXT_MODEL=command-a-plus-05-2026

# Optional — Alexa+ simulator TTS (Flash = cheapest; Sarah = default female)
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
