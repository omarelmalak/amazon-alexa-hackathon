# Required for POST /v1/products/ingest with "enrich": true
# (Cohere Command A Vision reads diagram PNGs as base64 data URLs)
COHERE_API_KEY=your-cohere-api-key-here

# Optional alias accepted by the app (Cohere dashboard often uses this name)
# CO_API_KEY=your-cohere-api-key-here

# Optional — vision model for manifest enrichment
COHERE_ENRICH_MODEL=command-a-vision-07-2025
